# Copiez ce fichier en ".env.local" (à la racine du projet) et remplissez les valeurs.
# Ces deux informations se trouvent dans Supabase : Project Settings > API.
# Le site fonctionne déjà sans ces variables (contenu par défaut) ;
# elles activent le stockage en base de données et l'espace /admin.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
